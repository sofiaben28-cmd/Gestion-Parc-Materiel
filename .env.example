# ============================================
# CONFIGURATION EMAIL - Gestion Matériel IUT
# ============================================
# Copier ce fichier en .env et remplir vos informations
# ============================================

# Email Gmail pour l'envoi des codes de vérification
# IMPORTANT : Utilisez un "Mot de passe d'application" Gmail
# Tutoriel : https://support.google.com/accounts/answer/185833
MAIL_USERNAME=votre_email@gmail.com
MAIL_PASSWORD=votre_mot_de_passe_application_gmail

# Clé secrète Flask (générer une clé aléatoire)
# Exemple de génération : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cle_secrete_a_generer_aleatoirement_minimum_32_caracteres
